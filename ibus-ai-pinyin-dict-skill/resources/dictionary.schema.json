{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/volsifly/ibus_llm_pinyin_input/dictionary.schema.json",
  "title": "ibus-ai-pinyin domain dictionary",
  "type": "object",
  "required": [
    "version",
    "name",
    "entries"
  ],
  "additionalProperties": true,
  "properties": {
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "locale": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "term"
        ],
        "additionalProperties": true,
        "properties": {
          "term": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "pinyin": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "short": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "type": {
            "type": "string",
            "enum": [
              "product",
              "project",
              "system",
              "module",
              "feature",
              "organization",
              "person",
              "tech",
              "abbreviation",
              "business",
              "mixed",
              "other"
            ]
          },
          "weight": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "comment": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        }
      }
    }
  }
}